    "antd": "6.6.3",
    "antd-style": "^4.1.0",
    "cytoscape": "^3.34.3",
    "cytoscape-dagre": "^4.0.1",
    "dayjs": "^1.11.23",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3",

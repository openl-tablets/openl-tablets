    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vitest-fail-on-console": "^0.10.1"
  },
  "scripts": {
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "build": "license-checker-rseidelsohn --onlyAllow \"MIT;Apache-2.0;BSD-3-Clause;ISC;0BSD\" --production --excludePrivatePackages && vite build",
    "serve": "vite preview --port 3002",
    "clean": "rm -rf dist",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }

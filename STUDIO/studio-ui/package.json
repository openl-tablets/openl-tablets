    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.5",
    "@stomp/stompjs": "^7.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "antd": "6.6.5",
    "antd-style": "^4.1.0",
    "cytoscape": "^3.34.3",
    "cytoscape-dagre": "^4.0.1",
    "dayjs": "^1.11.23",
    "fflate": "^0.8.3",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "i18next": "^26.4.2",

  "//": [
    "TypeScript runs side by side until TypeScript 7.1 ships its API and typescript-eslint supports it",
    "(https://github.com/typescript-eslint/typescript-eslint/issues/10940). @typescript/native is TypeScript 7,",
    "whose tsc type-checks; typescript is TypeScript 6, whose API typescript-eslint parses with.",
    "Then remove this workaround: depend on typescript ^7.1 alone and drop @typescript/native."
  ],
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vitest-fail-on-console": "^0.10.1"
  },
  "scripts": {
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "build": "license-checker-rseidelsohn --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;BlueOak-1.0.0;ISC;Python-2.0;0BSD;Unlicense\" --production --excludePrivatePackages && vite build",
    "serve": "vite preview --port 3002",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "browserslist": {
    "production": [
      "baseline 2025",
      "Firefox ESR"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}

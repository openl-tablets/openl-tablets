    <build>
        <defaultGoal>package</defaultGoal>
        <finalName>openl-studio</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <openapi.output.dir>${project.build.directory}/openapi/</openapi.output.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.basepom.maven</groupId>
                <artifactId>duplicate-finder-maven-plugin</artifactId>
                <configuration>
                    <checkCompileClasspath>false</checkCompileClasspath>
                    <checkRuntimeClasspath>true</checkRuntimeClasspath>
                    <checkTestClasspath>false</checkTestClasspath>
                    <failBuildInCaseOfConflict>true</failBuildInCaseOfConflict>
                    <useResultFile>false</useResultFile>
                    <exceptions>
                        <exception>
                            <conflictingDependencies>
                                <dependency>
                                    <groupId>com.github.java-json-tools</groupId>
                                    <artifactId>json-schema-core</artifactId>
                                </dependency>
                                <dependency>
                                    <groupId>com.github.java-json-tools</groupId>
                                    <artifactId>json-schema-validator</artifactId>
                                </dependency>
                            </conflictingDependencies>
                            <resources>
                                <resource>draftv3/schema</resource>
                                <resource>draftv4/schema</resource>
                            </resources>
                        </exception>
                        <exception>
                            <conflictingDependencies>
                                <dependency>
                                    <groupId>xml-apis</groupId>
                                    <artifactId>xml-apis</artifactId>
                                </dependency>
                                <dependency>
                                    <groupId>xml-apis</groupId>
                                    <artifactId>xml-apis-ext</artifactId>
                                </dependency>
                            </conflictingDependencies>
                            <resources>
                                <resource>license/LICENSE.dom-documentation.txt</resource>
                                <resource>license/README.dom.txt</resource>
                                <resource>license/LICENSE.dom-software.txt</resource>
                            </resources>
                        </exception>
                    </exceptions>
                    <ignoredResourcePatterns>
                        <ignoredResourcePattern>mozilla/public-suffix-list.txt</ignoredResourcePattern>
                        <ignoredResourcePattern>openl-default.properties</ignoredResourcePattern>
                        <ignoredResourcePattern>about.html</ignoredResourcePattern>
                        <ignoredResourcePattern>plugin.properties</ignoredResourcePattern>
                    </ignoredResourcePatterns>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <!-- The optional dependencies the war still ships: the war plugin leaves an optional
                                 dependency out, so they reach WEB-INF/lib as a web resource. -->
                            <outputDirectory>${project.build.directory}/optional-libs</outputDirectory>
                            <includeArtifactIds>log4j-api,log4j-core,log4j-slf4j2-impl,studio-docs,org.openl.rules.demo</includeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>backend-licenses</id>
                        <goals>
                            <goal>add-third-party</goal>
                        </goals>
                        <!-- Only the war takes the list. -->
                        <phase>prepare-package</phase>
                        <configuration>
                            <!-- The third-party libraries of WEB-INF/lib, which the About dialog lists. The
                                 modules of OpenL Tablets are the org.openl.rules* groups and the org.openl.*
                                 artifacts; other org.openl groups are patched third-party libraries. -->
                            <excludedScopes>provided,system,test</excludedScopes>
                            <excludedGroups>org\.openl\.rules</excludedGroups>
                            <excludedArtifacts>org\.openl\.</excludedArtifacts>
                            <fileTemplate>${project.basedir}/license/backend-licenses.json.ftl</fileTemplate>
                            <thirdPartyFilename>backend-licenses.json</thirdPartyFilename>
                            <outputDirectory>${project.build.directory}/licenses</outputDirectory>
                            <!-- A web resource served at /licenses, beside the list of the frontend libraries. -->
                            <addOutputDirectoryAsResourceDir>false</addOutputDirectoryAsResourceDir>
                            <!-- Each license is named by its SPDX identifier, as the frontend libraries name
                                 theirs: the first name of a merge is the identifier, the others are the names the
                                 POMs give it. EDL 1.0 is BSD-3-Clause and the Bouncy Castle Licence is MIT, as SPDX
                                 reads them. -->
                            <licenseMerges>
                                <licenseMerge>Apache-2.0
                                    | Apache 2 | Apache 2.0 | Apache License 2.0 | Apache License Version 2.0
                                    | Apache License, Version 2.0 | Apache License, version 2.0
                                    | The Apache License, Version 2.0 | The Apache Software License, Version 2.0</licenseMerge>
                                <licenseMerge>BSD-3-Clause
                                    | BSD License | EDL 1.0 | Eclipse Distribution License - v 1.0
                                    | Eclipse Distribution License v. 1.0</licenseMerge>
                                <licenseMerge>BSD-2-Clause | The BSD 2-Clause License</licenseMerge>
                                <licenseMerge>CC0-1.0 | Public Domain, per Creative Commons CC0</licenseMerge>
                                <licenseMerge>EPL-1.0 | EPL 1.0</licenseMerge>
                                <licenseMerge>EPL-2.0 | EPL 2.0 | Eclipse Public License v. 2.0</licenseMerge>
                                <licenseMerge>GPL-2.0-only WITH Classpath-exception-2.0
                                    | GPL2 w/ CPE | GPL-2.0-with-classpath-exception
                                    | GNU General Public License, version 2 with the GNU Classpath Exception</licenseMerge>
                                <licenseMerge>LGPL-2.1-or-later | LGPL 2.1 | GNU Library General Public License v2.1 or later</licenseMerge>
                                <licenseMerge>LGPL-3.0-only | GNU Lesser General Public License</licenseMerge>
                                <licenseMerge>MIT | The MIT License (MIT) | Bouncy Castle Licence</licenseMerge>
                                <licenseMerge>MPL-1.1 | MPL 1.1</licenseMerge>
                                <licenseMerge>MPL-2.0 | MPL 2.0</licenseMerge>
                            </licenseMerges>
                            <!-- Fails on a license named otherwise, so a new name is merged above rather than shown.
                                 Every identifier here has a public text the About dialog links to (studio-ui
                                 services/licenses.ts). -->
                            <includedLicenses>
                                <includedLicense>Apache-2.0</includedLicense>
                                <includedLicense>BSD-2-Clause</includedLicense>
                                <includedLicense>BSD-3-Clause</includedLicense>
                                <includedLicense>CC0-1.0</includedLicense>
                                <includedLicense>EPL-1.0</includedLicense>
                                <includedLicense>EPL-2.0</includedLicense>
                                <includedLicense>GPL-2.0-only WITH Classpath-exception-2.0</includedLicense>
                                <includedLicense>LGPL-2.1-or-later</includedLicense>
                                <includedLicense>LGPL-3.0-only</includedLicense>
                                <includedLicense>MIT</includedLicense>
                                <includedLicense>MIT-0</includedLicense>
                                <includedLicense>MPL-1.1</includedLicense>
                                <includedLicense>MPL-2.0</includedLicense>
                            </includedLicenses>
                            <failOnBlacklist>true</failOnBlacklist>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The war is an asset of the GitHub release, not of Maven Central. Nothing else depends on this
                 module, so it deploys nothing at all; it is still installed into the local repository for the
                 integration tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <webResources>
                        <resource>
                            <directory>${project.build.directory}/optional-libs</directory>
                            <targetPath>WEB-INF/lib</targetPath>
                        </resource>
                        <resource>
                            <directory>${project.build.directory}/licenses</directory>
                            <targetPath>licenses</targetPath>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

    <session-config>
        <session-timeout>30</session-timeout>
        <tracking-mode>COOKIE</tracking-mode>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <display-name>OpenL Studio</display-name>
    <description>OpenL Studio</description>

    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>org.openl.rules.webstudio.web.servlet.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>ForwardedFilter</filter-name>
        <filter-class>de.qaware.xff.filter.ForwardedHeaderFilter</filter-class>
        <init-param>
            <param-name>xForwardedPrefixStrategy</param-name>
            <param-value>PREPEND</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>ForwardedFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>SecurityFilter</filter-name>
        <filter-class>org.openl.studio.security.SecurityFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SecurityFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Names the client of every change, so a session can tell its own echo from a change made
         through another client of the same user - an integration, an MCP server, the legacy pages. -->
    <filter>
        <filter-name>changeOriginFilter</filter-name>
        <filter-class>org.openl.studio.projects.messaging.ChangeOriginFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>changeOriginFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <listener>
        <listener-class>org.openl.rules.webstudio.web.servlet.SpringInitializer</listener-class>
    </listener>

    <listener>
        <listener-class>org.openl.rules.webstudio.web.servlet.SessionListener</listener-class>
    </listener>

    <listener>
        <listener-class>org.springframework.web.context.request.RequestContextListener</listener-class>
    </listener>

</web-app>

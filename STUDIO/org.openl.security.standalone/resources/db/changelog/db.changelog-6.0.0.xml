<?xml version="1.0" encoding="UTF-8"?>
<!--
 Security schema of OpenL Tablets 6.0.0. It is the baseline of the change log: the schema 6.0.0 left behind is
 the starting point, instead of the release-by-release history that produced it.

 The change log brings every supported database to that schema:

 - an empty database gets the whole schema, the default groups and the default permissions created;
 - a database of 5.27.15 already carries most of it, so only what 6.0.0 added is applied to it: the personal
   access tokens, the index over the external group names, and the conversion of the permissions into the
   roles of the current model;
 - a database of 6.0.0 or later is adopted as it is, and nothing here touches its data.

 Each change set decides for itself which of the three it is looking at, through a precondition that marks it
 as run when its change is already there. A database of a release before 5.27.10 is none of the three, and the
 guard below stops the migration instead of leaving such a database half converted.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
                   objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!--
     Releases before 5.27.10 kept the group hierarchy in OpenL_Group2Group; 5.27.10 flattened it into the group
     memberships and the access control entries, and then dropped the table. The change set that flattens it is
     no longer here, so a database that still carries the table cannot be converted, and the migration stops on
     it instead of leaving it half converted. 5.27.15 is the oldest release the conversion is tested against.
    -->
    <changeSet id="6.0.0-supported-source-schema" author="ymolchan">
        <preConditions onFail="HALT"
                       onFailMessage="The security database comes from a release older than OpenL Tablets 5.27.10 and cannot be converted. Upgrade the installation to 5.27.15 or 6.0.0 first and start it once, so that it converts the database, and then upgrade to this version.">
            <not>
                <tableExists tableName="OpenL_Group2Group"/>
            </not>
        </preConditions>
        <comment>Refuses a database left behind by a release older than the oldest supported one</comment>

        <empty/>
    </changeSet>

    <changeSet id="6.0.0-users-and-groups" author="ymolchan">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="OpenL_Users"/>
            </not>
        </preConditions>
        <comment>Users, groups, group authorities and per-user settings</comment>

        <createTable tableName="OpenL_Users">
            <column name="loginName" type="${varchar}(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="firstName" type="${varchar}(50)"/>
            <column name="surname" type="${varchar}(50)"/>
            <column name="email" type="${varchar}(254)"/>
            <column name="displayName" type="${varchar}(64)"/>
            <column name="flags" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!--
         Liquibase counts "password" among the reserved words of Oracle and quotes it, which would create a
         column of that exact spelling while the application asks for the one Oracle folds to upper case.
         Plain SQL leaves the name to the database, as the migrations before Liquibase did.
        -->
        <sql>ALTER TABLE OpenL_Users ADD password ${varchar}(128)</sql>

        <createTable tableName="OpenL_Groups">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="groupName" type="${varchar}(65)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="${varchar}(200)"/>
        </createTable>

        <createTable tableName="OpenL_Group_Authorities">
            <column name="groupID" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="authority" type="${varchar}(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_OpenL_Group_Authorities1"
                                 baseTableName="OpenL_Group_Authorities" baseColumnNames="groupID"
                                 referencedTableName="OpenL_Groups" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <createTable tableName="OpenL_User2Group">
            <column name="loginName" type="${varchar}(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="groupID" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_OpenL_User2Group1"
                                 baseTableName="OpenL_User2Group" baseColumnNames="loginName"
                                 referencedTableName="OpenL_Users" referencedColumnNames="loginName"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint constraintName="fk_OpenL_User2Group2"
                                 baseTableName="OpenL_User2Group" baseColumnNames="groupID"
                                 referencedTableName="OpenL_Groups" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <createTable tableName="OpenL_UserSettings">
            <column name="loginName" type="${varchar}(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="settingKey" type="${varchar}(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="settingValue" type="${varchar}(16)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_OpenL_UserSettings1"
                                 baseTableName="OpenL_UserSettings" baseColumnNames="loginName"
                                 referencedTableName="OpenL_Users" referencedColumnNames="loginName"
                                 onDelete="CASCADE"/>

        <createTable tableName="OpenL_External_Groups">
            <column name="loginName" type="${varchar}(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="groupName" type="${varchar}(65)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_OpenL_External_Groups1"
                                 baseTableName="OpenL_External_Groups" baseColumnNames="loginName"
                                 referencedTableName="OpenL_Users" referencedColumnNames="loginName"
                                 onDelete="CASCADE"/>

        <!--
         Groups an empty installation starts with, and the only authority left after 6.0.0: ADMIN. They are
         seeded here rather than by a change set of their own, so that the precondition above is what decides:
         a schema handed over by an earlier release carries its own groups, possibly edited by an
         administrator, and must never be seeded again.
        -->
        <insert tableName="OpenL_Groups">
            <column name="groupName" value="Administrators"/>
        </insert>
        <insert tableName="OpenL_Groups">
            <column name="groupName" value="Viewers"/>
        </insert>
        <insert tableName="OpenL_Groups">
            <column name="groupName" value="Developers"/>
        </insert>
        <insert tableName="OpenL_Groups">
            <column name="groupName" value="Testers"/>
        </insert>
        <insert tableName="OpenL_Groups">
            <column name="groupName" value="Deployers"/>
        </insert>
        <insert tableName="OpenL_Groups">
            <column name="groupName" value="Analysts"/>
        </insert>
        <sql>
            INSERT INTO OpenL_Group_Authorities (groupID, authority)
            SELECT id, 'ADMIN' FROM OpenL_Groups WHERE groupName = 'Administrators'
        </sql>
    </changeSet>

    <changeSet id="6.0.0-external-groups-index" author="ymolchan">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_OpenL_External_Groups_groupName" tableName="OpenL_External_Groups"/>
            </not>
        </preConditions>
        <comment>Index that answers "who belongs to this external group" without a scan</comment>

        <createIndex indexName="idx_OpenL_External_Groups_groupName" tableName="OpenL_External_Groups">
            <column name="groupName"/>
        </createIndex>
    </changeSet>

    <changeSet id="6.0.0-projects-and-tags" author="ymolchan">

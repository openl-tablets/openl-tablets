            </column>
            <column name="name" type="${varchar}(255)">
                <constraints nullable="false"/>
            </column>
            <column name="extensible" type="${boolean}">
                <constraints nullable="false"/>
            </column>
            <column name="nullable" type="${boolean}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint constraintName="uni_OpenL_Tag_Types1" tableName="OpenL_Tag_Types" columnNames="name"/>

        <createTable tableName="OpenL_Tags">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tag_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="${varchar}(255)">

<?xml version="1.0" encoding="UTF-8"?>
<!--
 The tags a project can carry: the tag types, the tags of each type, and the templates that derive a tag from a
 project name.

 Only the vocabulary is here. The tables that attached a tag to a project, OpenL_Projects and
 OpenL_Project_Tags, belong to the releases before 6.0.0, which kept the attachment in the database; 6.0.0
 moved it into the project itself. ProjectTagsMigrator empties and drops them at the first startup after an
 upgrade, and a database that never had them does not need them.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
                   objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="tags" author="ymolchan">
        <!-- Edited when a release changes these tables; see the note in db.changelog-users.xml. -->
        <validCheckSum>1:any</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="OpenL_Tag_Types"/>
            </not>
        </preConditions>
        <comment>The tags a project can carry, and the templates that derive them from a project name</comment>

        <createTable tableName="OpenL_Tag_Types">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="${varchar}(255)">
                <constraints nullable="false"/>
            </column>
            <column name="extensible" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="nullable" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint constraintName="uni_OpenL_Tag_Types1" tableName="OpenL_Tag_Types" columnNames="name"/>

        <createTable tableName="OpenL_Tags">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tag_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="${varchar}(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint constraintName="uni_OpenL_Tags1" tableName="OpenL_Tags" columnNames="tag_type_id, name"/>
        <addForeignKeyConstraint constraintName="fk_OpenL_Tags1"
                                 baseTableName="OpenL_Tags" baseColumnNames="tag_type_id"
                                 referencedTableName="OpenL_Tag_Types" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <createTable tableName="OpenL_Tag_Templates">
            <column name="template" type="${varchar}(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="priority" type="INT"/>
        </createTable>
        <addUniqueConstraint constraintName="uni_OpenL_Tag_Templates1" tableName="OpenL_Tag_Templates"
                             columnNames="priority"/>
    </changeSet>

</databaseChangeLog>

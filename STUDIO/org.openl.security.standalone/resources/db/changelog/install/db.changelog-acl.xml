                                 referencedTableName="acl_object_identity" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_acl_object_identity_class"
                                 baseTableName="acl_object_identity" baseColumnNames="object_id_class"
                                 referencedTableName="acl_class" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_acl_object_identity_owner"
                                 baseTableName="acl_object_identity" baseColumnNames="owner_sid"
                                 referencedTableName="acl_sid" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_acl_entry_object"
                                 baseTableName="acl_entry" baseColumnNames="acl_object_identity"
                                 referencedTableName="acl_object_identity" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_acl_entry_acl"
                                 baseTableName="acl_entry" baseColumnNames="sid"
                                 referencedTableName="acl_sid" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="acl-default-permissions" author="ymolchan">
        <!-- Edited when a release changes the default permissions; see the note in db.changelog-users.xml. -->
        <validCheckSum>1:any</validCheckSum>
        <!--
         Only an access control list that is empty through and through is seeded. Emptying all three tables is
         beyond what the application does, so this recognizes a schema this change log has just created, and
         it never partially seeds one that already holds classes or object identities.
        -->
        <preConditions onFail="MARK_RAN">
            <and>
                <sqlCheck expectedResult="0">SELECT COUNT(*) FROM acl_sid</sqlCheck>
                <sqlCheck expectedResult="0">SELECT COUNT(*) FROM acl_class</sqlCheck>
                <sqlCheck expectedResult="0">SELECT COUNT(*) FROM acl_object_identity</sqlCheck>
            </and>
        </preConditions>
        <comment>Permissions an empty installation grants on the repository roots</comment>

        <!-- Every default group is an authority, not a single user, hence a non-principal security identity. -->
        <insert tableName="acl_sid">
            <column name="principal" valueBoolean="false"/>
            <column name="sid" value="ADMIN"/>
        </insert>
        <insert tableName="acl_sid">
            <column name="principal" valueBoolean="false"/>
            <column name="sid" value="Viewers"/>
        </insert>
        <insert tableName="acl_sid">
            <column name="principal" valueBoolean="false"/>
            <column name="sid" value="Developers"/>
        </insert>
        <insert tableName="acl_sid">
            <column name="principal" valueBoolean="false"/>
            <column name="sid" value="Testers"/>
        </insert>
        <insert tableName="acl_sid">
            <column name="principal" valueBoolean="false"/>
            <column name="sid" value="Deployers"/>
        </insert>
        <insert tableName="acl_sid">
            <column name="principal" valueBoolean="false"/>
            <column name="sid" value="Analysts"/>
        </insert>

        <insert tableName="acl_class">
            <column name="class" value="org.openl.security.acl.repository.Root"/>
            <column name="class_id_type" value="java.lang.String"/>
        </insert>
        <insert tableName="acl_class">
            <column name="class" value="org.openl.security.acl.repository.ProjectArtifact"/>
            <column name="class_id_type" value="java.lang.String"/>
        </insert>
        <insert tableName="acl_class">
            <column name="class" value="org.openl.security.acl.repository.DeploymentProjectArtifact"/>
            <column name="class_id_type" value="java.lang.String"/>
        </insert>
        <insert tableName="acl_class">
            <column name="class" value="org.openl.security.acl.repository.RepositoryObjectIdentity"/>
            <column name="class_id_type" value="java.lang.String"/>
        </insert>

        <!--
         Root of the design repositories ("1"), of the deploy configurations ("2") and of the production
         repositories ("3"). Every artefact below a root inherits the permissions of that root, and the
         administrators own all three.
        -->
        <insert tableName="acl_object_identity">
            <column name="object_id_class" valueComputed="(SELECT id FROM acl_class WHERE class = 'org.openl.security.acl.repository.Root')"/>
            <column name="object_id_identity" value="1"/>
            <column name="owner_sid" valueComputed="(SELECT id FROM acl_sid WHERE sid = 'ADMIN')"/>
            <column name="entries_inheriting" valueBoolean="true"/>
        </insert>
        <insert tableName="acl_object_identity">
            <column name="object_id_class" valueComputed="(SELECT id FROM acl_class WHERE class = 'org.openl.security.acl.repository.Root')"/>
            <column name="object_id_identity" value="2"/>
            <column name="owner_sid" valueComputed="(SELECT id FROM acl_sid WHERE sid = 'ADMIN')"/>
            <column name="entries_inheriting" valueBoolean="true"/>
        </insert>
        <insert tableName="acl_object_identity">
            <column name="object_id_class" valueComputed="(SELECT id FROM acl_class WHERE class = 'org.openl.security.acl.repository.Root')"/>
            <column name="object_id_identity" value="3"/>
            <column name="owner_sid" valueComputed="(SELECT id FROM acl_sid WHERE sid = 'ADMIN')"/>
            <column name="entries_inheriting" valueBoolean="true"/>
        </insert>

        <!--
         Permission masks: 1 is VIEW, 2 is EDIT, 4 is CREATE, 8 is DELETE, and 15 is all four of them. Every
         default group sees every repository root; developers and analysts also edit the design repositories,
         and deployers also edit the deploy configurations and the production repositories. The administrators
         own the roots and need no entry of their own.
        -->
        <insert tableName="acl_entry">
            <column name="acl_object_identity" valueComputed="(SELECT id FROM acl_object_identity WHERE object_id_identity = '1')"/>
            <column name="ace_order" valueNumeric="1"/>
            <column name="sid" valueComputed="(SELECT id FROM acl_sid WHERE sid = 'Deployers')"/>
            <column name="mask" valueNumeric="1"/>
            <column name="granting" valueBoolean="true"/>
            <column name="audit_success" valueBoolean="false"/>
            <column name="audit_failure" valueBoolean="false"/>
        </insert>
        <insert tableName="acl_entry">
            <column name="acl_object_identity" valueComputed="(SELECT id FROM acl_object_identity WHERE object_id_identity = '1')"/>
            <column name="ace_order" valueNumeric="2"/>
            <column name="sid" valueComputed="(SELECT id FROM acl_sid WHERE sid = 'Developers')"/>
            <column name="mask" valueNumeric="15"/>
            <column name="granting" valueBoolean="true"/>
            <column name="audit_success" valueBoolean="false"/>
            <column name="audit_failure" valueBoolean="false"/>
        </insert>
        <insert tableName="acl_entry">

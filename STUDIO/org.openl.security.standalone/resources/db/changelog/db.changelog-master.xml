<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
                   objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!--
     Identifiers are written the way the migration tool before Liquibase wrote them: unquoted, so that every
     database folds them by its own rules. Quoting them would create objects an upgraded database does not have
     and the application cannot address - on PostgreSQL every mixed-case name, and on Oracle every name
     Liquibase counts as reserved.
    -->

    <!--
     Character type that stores Unicode on every supported database. PostgreSQL, MySQL, MariaDB and H2 store
     Unicode in VARCHAR, while SQL Server and Oracle need the national variant for it.
    -->
    <property name="varchar" value="VARCHAR" dbms="h2,postgresql,mysql,mariadb"/>
    <property name="varchar" value="NVARCHAR" dbms="mssql"/>
    <property name="varchar" value="NVARCHAR2" dbms="oracle"/>

    <!--
     Timestamp type with the widest range and the best precision of each database. MySQL and MariaDB need
     DATETIME, because their TIMESTAMP is limited to the year 2038, and the fractional part is not stored
     unless its precision is spelled out.
    -->
    <property name="timestamp" value="TIMESTAMP" dbms="h2,postgresql,oracle"/>
    <property name="timestamp" value="DATETIME(6)" dbms="mysql,mariadb"/>
    <property name="timestamp" value="DATETIME" dbms="mssql"/>

    <!--
     Boolean type and literals. Oracle gained a boolean type in 23ai only, and the supported releases start at
     19c, so a one-digit number carries the flags there and the literals are spelled out for it and for SQL
     Server. Naming the Oracle type keeps a database created on 23ai identical to one upgraded to it.
    -->
    <property name="boolean" value="BOOLEAN" dbms="h2,postgresql,mysql,mariadb,mssql"/>
    <property name="boolean" value="NUMBER(1,0)" dbms="oracle"/>
    <property name="booleanTrue" value="TRUE" dbms="h2,postgresql,mysql,mariadb"/>
    <property name="booleanTrue" value="1" dbms="mssql,oracle"/>
    <property name="booleanFalse" value="FALSE" dbms="h2,postgresql,mysql,mariadb"/>
    <property name="booleanFalse" value="0" dbms="mssql,oracle"/>

    <!--
     Length of the Spring Security ACL identifier columns, as each database was given it by earlier releases.
     A unique index covers the columns, and MySQL and MariaDB are the tightest: an InnoDB index key holds
     3072 bytes, which is 766 characters of four bytes each.
    -->
    <property name="aclClassLength" value="65535" dbms="postgresql"/>
    <property name="aclClassLength" value="2000" dbms="h2,mssql,oracle"/>
    <property name="aclClassLength" value="765" dbms="mysql,mariadb"/>
    <property name="aclIdentityLength" value="65535" dbms="h2,postgresql"/>
    <property name="aclIdentityLength" value="4000" dbms="mssql"/>
    <property name="aclIdentityLength" value="2000" dbms="oracle"/>
    <property name="aclIdentityLength" value="766" dbms="mysql,mariadb"/>

    <include file="db.changelog-6.0.0.xml" relativeToChangelogFile="true"/>
    <include file="db.changelog-6.4.0.xml" relativeToChangelogFile="true"/>
    <include file="db.changelog-6.5.0.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>

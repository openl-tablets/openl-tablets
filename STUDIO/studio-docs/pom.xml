<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.openl.rules</groupId>
        <artifactId>org.openl.rules.studio-pom</artifactId>
        <version>7.1.0-SNAPSHOT</version>
    </parent>
    <groupId>org.openl.rules.studio</groupId>
    <artifactId>studio-docs</artifactId>
    <name>OpenL - STUDIO Docs</name>
    <description>The user guides OpenL Studio shows at /docs</description>
    <url>https://openl-tablets.org</url>
    <organization>
        <name>OpenL Tablets</name>
        <url>https://openl-tablets.org</url>
    </organization>
    <properties>
        <!-- Ships inside the OpenL Studio war only, so no other build needs it from a remote repository. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- The root pom skips the install together with the deploy, but a war built outside the reactor still
             resolves the jar from the local repository. -->
        <maven.install.skip>false</maven.install.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-autolink</artifactId>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-tables</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-yaml-front-matter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- The guides are kept with the documentation site, which publishes the same files. -->
            <resource>
                <targetPath>META-INF/resources/docs</targetPath>
                <directory>${project.basedir}/../../Docs/user-guides</directory>
                <!-- The conventions for writing a folder are not a page of it -->
                <excludes>
                    <exclude>**/AGENTS.md</exclude>
                </excludes>
            </resource>
            <!-- The specifications of the project files, which the MCP server of OpenL Studio reads from there. -->
            <resource>
                <targetPath>META-INF/resources/docs/ref</targetPath>
                <directory>${project.basedir}/../../Docs/ref</directory>
                <excludes>
                    <exclude>AGENTS.md</exclude>
                </excludes>
            </resource>
            <!-- The migration notes of the releases since 5.25, one folder a release, which OpenL Studio lists as
                 Migration Notes. Its MCP server reads the part of each one for Rules Authors. -->
            <resource>
                <targetPath>META-INF/resources/docs/migration-notes</targetPath>
                <directory>${project.basedir}/../../Docs/release-notes</directory>
                <includes>
                    <include>*/migration.md</include>
                </includes>
                <!-- The releases before 5.25: 5.5 to 5.9, 5.10 to 5.19, then 5.20 to 5.24 -->
                <excludes>
                    <exclude>5.?.*/**</exclude>
                    <exclude>5.1?.*/**</exclude>
                    <exclude>5.20.*/**</exclude>
                    <exclude>5.21.*/**</exclude>
                    <exclude>5.22.*/**</exclude>
                    <exclude>5.23.*/**</exclude>
                    <exclude>5.24.*/**</exclude>
                </excludes>
            </resource>
        </resources>
    </build>
</project>

POST /rest/projects/{PROJECT}/tables HTTP/1.1
Authorization: ${ADMIN_AUTH_TOCKEN}
Content-Type: application/json

{
  "moduleName": "Main",
  "sheetName": "Messages",
  "table": {
    "tableType": "SimpleSpreadsheet",
    "kind": "Spreadsheet",
    "name": "Greet",
    "returnType": "SpreadsheetResult",
    "steps": [
      {
        "name": "Shared",
        "value": "= msg(\"shared.greeting\")"
      },
      {
        "name": "Overridden",
        "value": "= msg(\"overridden\")"
      },
      {
        "name": "Own",
        "value": "= msg(\"own\")"
      },
      {
        "name": "Library",
        "value": "= msg(\"library.greeting\")"
      },
      {
        "name": "Absent",
        "value": "= msg(\"absent\")"
      }
    ]
  }
}

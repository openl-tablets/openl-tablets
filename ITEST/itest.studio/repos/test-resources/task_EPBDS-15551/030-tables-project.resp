    {
      "id": "HKVZVPWWFB1S1EZ5",
      "tableType": "Spreadsheet",
      "kind": "Spreadsheet",
      "name": "IsAdequateNormativeIndexCalculation",
      "properties": {
        "description": "The third correction index B3 (IsAdequate Normative Index) is determined on basis of the abidance of requirements established by the central bank of the bank-counterparty: adequate core capital ratio (N1), adequate liquidity ratio (N2), adequate max credit risk (N3). For banks – residents of Belarus it is also used the indicator of equity (N4). B3 is taken as the minimum value of these four values obtained: B3 = min {N1, N2, N3, N4}."
      },
      "returnType": "Double",
      "signature": "IsAdequateNormativeIndexCalculation (Bank bank)",
      "file": "EPBDS-15551/Bank Rating.xlsx",

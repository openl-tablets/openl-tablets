  "content": [
    {
      "id": "D15Q6ZBH4B17Y86M",
      "tableType": "Spreadsheet",
      "kind": "Spreadsheet",
      "name": "BalanceDynamicIndexCalculation",
      "properties": {
        "description": "The analysis of dynamic performance of such factors as capital (D1), quick liquidity (D2), liquidity (D3), profit (D4) and liabilities to customers (D5) is used for calculating the first correction index B1 (Balance Dynamic Index). Final value of B1 is the arithmetic mean of the scores of these five factors obtained: B1 = (D1 + D2 + D3 + D4 + D5) / 5."
      },
      "returnType": "Double",
      "signature": "BalanceDynamicIndexCalculation (FinancialData currentFinancialData, FinancialData previousFinancialData)",
      "file": "EPBDS-15551/Bank Rating.xlsx",
      "sheet": "Rating Algorithm",
      "pos": "D54:G68",
      "hasTests": true,
      "module": "Bank Rating",
      "project": "EPBDS-15551",
      "projectId": "WMSR6ZHRW7VFF"
    },
    {
      "id": "HMNKP31PFGAB35VW",
      "tableType": "Spreadsheet",
      "kind": "Spreadsheet",
      "name": "BalanceQualityIndexCalculation",
      "properties": {
        "description": "To calculate the Balance Quality Index B, which is used for determining the Bank Rating Group, there identifies the following 10 indicators and its scores: Capital Adequacy (Q1), Claims on  Customer Ratio in Assets (Q2), Quality of Credit Portfolio (Q3), Secured by Property Charges Claims Ratio (Q4), Quick Ratio (Q5), Liquidity Ratio (Q6), High Liquidity Ratio (Q7), Net Liabilities at Money Market (Q8), Liabilities to Customers on Demand Ratio (Q9), Other Assets Ratio (Q10). Each range of possible values of the indicators is assigned a score between 0 and 1 (\"0\" corresponds to the critical value of the range,\"1\" - the optimal value). \n          The Balance Quality Index B is calculated as product of score of indicators: B = Q1 * Q2 *...* Q10. Obtained value B reflects current financial bank-counterparty state only due to the balance sheet. It is the basis for further work on the definition of the Limit."
      },
      "returnType": "SpreadsheetResult",
      "signature": "BalanceQualityIndexCalculation (FinancialData currentFinancialData)",
      "file": "EPBDS-15551/Bank Rating.xlsx",
      "sheet": "Rating Algorithm",
      "pos": "D26:G49",
      "hasTests": true,
      "module": "Bank Rating",
      "project": "EPBDS-15551",
      "projectId": "WMSR6ZHRW7VFF"
    },

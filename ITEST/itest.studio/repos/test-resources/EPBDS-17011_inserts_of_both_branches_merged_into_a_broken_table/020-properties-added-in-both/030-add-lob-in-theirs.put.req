    "lob": "Auto"
  },
  "returnType": "Double",
  "args": [
    {
      "name": "plan",
      "type": "String"
    }
  ],
  "headers": [
    {
      "title": "Plan"
    },
    {
      "title": "Discount"
    }
  ],
  "rules": [
    {
      "Plan": "Basic",
      "Discount": 0.05
    },
    {
      "Plan": "Premium",
      "Discount": 0.1
    }
  ]
}


POST /rest/projects/{PROJECT_ID}/files/?conflictPolicy=OVERWRITE HTTP/1.1
Authorization: ${ADMIN_AUTH_TOCKEN}
Content-Type: multipart/form-data; boundary=MULTIBOUND

--MULTIBOUND
Content-Disposition: form-data; name="file"; filename="u-tree/sub/alpha.txt"
Content-Type: text/plain

tree alpha two

--MULTIBOUND

  "id": 1,
  "method": "tools/call",
  "params": {
    "name": "openl_create_project_table",
    "arguments": {
      "projectId": "${PROJECT_ID}",
      "moduleName": "Main",
      "sheetName": "Rules",
      "table": {
        "tableType": "RawSource",
        "name": "AgeFactor",
        "source": [
          [
            {
              "value": "SimpleRules Double AgeFactor(Integer age)"
            },
            {
              "value": null
            }
          ],
          [
            {
              "value": "Age"
            },
            {
              "value": "Factor"
            }
          ],
          [
            {
              "value": "< 25"
            },
            {
              "value": 1.5
            }
          ],
          [
            {
              "value": "25 - 65"
            },
            {
              "value": 1
            }
          ],
          [
            {
              "value": "> 65"
            },
            {
              "value": 1.2
            }
          ]
        ]
      }
    },
    "_meta": {
      "io.modelcontextprotocol/protocolVersion": "2026-07-28",
      "io.modelcontextprotocol/clientInfo": {
        "name": "itest",
        "version": "1.0.0"

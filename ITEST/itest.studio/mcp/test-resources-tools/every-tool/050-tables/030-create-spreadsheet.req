POST /mcp HTTP/1.1
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2026-07-28
Mcp-Method: tools/call
Mcp-Name: openl_create_project_table
Authorization: Bearer ${PAT}

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/call",
  "params": {
    "name": "openl_create_project_table",
    "arguments": {
      "projectId": "${PROJECT_ID}",
      "moduleName": "Main",
      "sheetName": "Rules",
      "table": {
        "tableType": "RawSource",
        "name": "Premium",
        "source": [
          [
            {
              "value": "Spreadsheet Double Premium(Driver driver)"
            },
            {
              "value": null
            }
          ],
          [
            {
              "value": "Step"
            },
            {
              "value": "Value"
            }
          ],
          [
            {
              "value": "Base"
            },
            {
              "value": 100
            }
          ],
          [
            {
              "value": "Factor"
            },
            {
              "value": "= AgeFactor(driver.age)"
            }
          ],
          [
            {
              "value": "Total"
            },
            {
              "value": "= $Value$Base * $Value$Factor"
            }
          ]
        ]
      }
    },
    "_meta": {
      "io.modelcontextprotocol/protocolVersion": "2026-07-28",
      "io.modelcontextprotocol/clientInfo": {
        "name": "itest",
        "version": "1.0.0"
      },
      "io.modelcontextprotocol/clientCapabilities": {}
    }
  }
}

POST /mcp HTTP/1.1
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2026-07-28
Mcp-Method: tools/call
Mcp-Name: openl_project_localization_edit
Authorization: Token ${PAT}

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/call",
  "params": {
    "name": "openl_project_localization_edit",
    "arguments": {
      "projectId": "${PROJECT_ID}",
      "actions": [
        {
          "action": "add_language",
          "language": "",
          "values": {
            "greeting": "Hello, {0}!"
          }
        },
        {
          "action": "add_language",
          "language": "de",
          "values": {
            "greeting": "Hallo, {0}!"
          }
        },
        {
          "action": "add_key",
          "key": "farewell",
          "values": {
            "": "Bye",
            "de": "Tschüss"
          }
        }
      ]
    },
    "_meta": {
      "io.modelcontextprotocol/protocolVersion": "2026-07-28",
      "io.modelcontextprotocol/clientInfo": {
        "name": "itest",
        "version": "1.0.0"
      },
      "io.modelcontextprotocol/clientCapabilities": {}
    }
  }
}

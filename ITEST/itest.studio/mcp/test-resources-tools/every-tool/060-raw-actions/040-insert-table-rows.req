  "params": {
    "name": "openl_insert_table_rows",
    "arguments": {
      "projectId": "${PROJECT_ID}",
      "tableId": "${GRADE_ID}",
      "position": 3,
      "cells": [
        [
          {
            "value": "50 - 59"
          },
          {
            "value": "E"
          }
        ],
        [
          {
            "value": "60 - 69"
          },
          {
            "value": "D"
          }
        ]
      ]
    },
    "_meta": {
      "io.modelcontextprotocol/protocolVersion": "2026-07-28",

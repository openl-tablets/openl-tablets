<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.openl.rules</groupId>
        <artifactId>org.openl.rules.dev-pom</artifactId>
        <version>6.5.0-SNAPSHOT</version>
    </parent>
    <artifactId>org.openl.rules.test</artifactId>
    <packaging>jar</packaging>
    <name>OpenL - TEST</name>
    <description>OpenL Functionality Tests</description>
    <url>https://openl-tablets.org</url>
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- 2MB over the project-wide perf budget, measured as the least that fits Groovy 6. Its runtime
             occupies more of the heap at rest than Groovy 4 did, which left EPBDS-8059_Not_very_big_Spreadsheet
             without the headroom its SpreadsheetResult.toMap() call needs. The boundary is sharp: three runs
             of the module pass at 63m and all three fail at 62m. The noPerf budget is untouched, and so is
             the perf budget of every other module, so both keep detecting leaks as before. -->
        <surefire.argLine.perf>-Xms8m -Xmx63m -Xss256k -XX:MaxMetaspaceSize=160m</surefire.argLine.perf>
    </properties>

    <dependencies>
        <!-- Required for Java11 -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <scope>test</scope>
            <!-- Annotation classes are used in generated from Datatype Table classes.
            To compile them without adding extra dependency in client's project "compile" scope is used -->
        </dependency>

        <!-- OpenL dependencies -->
        <dependency>
            <groupId>org.openl.rules</groupId>
            <artifactId>org.openl.rules.project</artifactId>
        </dependency>
    </dependencies>
</project>
